<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0"
    xmlns:xsl="http://www.w3.org/1999/XSL/Transform">

  <xsl:output method="text" encoding="UTF-8"/>
  <xsl:param name="table" select="'mdl_user_import'"/>

  <xsl:template match="/">
    <xsl:text>-- Generated by Ant/XSLT.&#10;</xsl:text>
    <xsl:text>-- Review against your Moodle/database schema before execution.&#10;&#10;</xsl:text>
    <xsl:for-each select="users/user">
      <xsl:text>INSERT INTO </xsl:text><xsl:value-of select="$table"/>
      <xsl:text> (id, username, email, firstname, lastname, idnumber, password, city, country) VALUES (</xsl:text>
      <xsl:value-of select="id"/><xsl:text>, </xsl:text>
      <xsl:call-template name="sql-string"><xsl:with-param name="v" select="username"/></xsl:call-template><xsl:text>, </xsl:text>
      <xsl:call-template name="sql-string"><xsl:with-param name="v" select="email"/></xsl:call-template><xsl:text>, </xsl:text>
      <xsl:call-template name="sql-string"><xsl:with-param name="v" select="firstname"/></xsl:call-template><xsl:text>, </xsl:text>
      <xsl:call-template name="sql-string"><xsl:with-param name="v" select="lastname"/></xsl:call-template><xsl:text>, </xsl:text>
      <xsl:call-template name="sql-string"><xsl:with-param name="v" select="idnumber"/></xsl:call-template><xsl:text>, </xsl:text>
      <xsl:call-template name="sql-string"><xsl:with-param name="v" select="password"/></xsl:call-template><xsl:text>, </xsl:text>
      <xsl:call-template name="sql-string"><xsl:with-param name="v" select="city"/></xsl:call-template><xsl:text>, </xsl:text>
      <xsl:call-template name="sql-string"><xsl:with-param name="v" select="country"/></xsl:call-template>
      <xsl:text>);&#10;</xsl:text>
    </xsl:for-each>
  </xsl:template>

  <xsl:template name="sql-string">
    <xsl:param name="v"/>
    <xsl:text>'</xsl:text>
    <xsl:call-template name="replace">
      <xsl:with-param name="text" select="$v"/>
      <xsl:with-param name="from" select="&quot;'&quot;"/>
      <xsl:with-param name="to" select="&quot;''&quot;"/>
    </xsl:call-template>
    <xsl:text>'</xsl:text>
  </xsl:template>

  <xsl:template name="replace">
    <xsl:param name="text"/>
    <xsl:param name="from"/>
    <xsl:param name="to"/>
    <xsl:choose>
      <xsl:when test="contains($text, $from)">
        <xsl:value-of select="substring-before($text, $from)"/>
        <xsl:value-of select="$to"/>
        <xsl:call-template name="replace">
          <xsl:with-param name="text" select="substring-after($text, $from)"/>
          <xsl:with-param name="from" select="$from"/>
          <xsl:with-param name="to" select="$to"/>
        </xsl:call-template>
      </xsl:when>
      <xsl:otherwise><xsl:value-of select="$text"/></xsl:otherwise>
    </xsl:choose>
  </xsl:template>

</xsl:stylesheet>
